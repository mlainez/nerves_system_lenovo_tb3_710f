# Lenovo Tab3 7 (TB3-710F): MediaTek MT8127, 4x Cortex-A7, 1 GB RAM.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/nerves-project/toolchains/releases/download/v15.3.1/nerves_toolchain_armv7_nerves_linux_gnueabihf-linux_${shell uname -m}-15.3.1-3EB2D2F.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="armv7-nerves-linux-gnueabihf"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_0=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TAR_OPTIONS="--no-same-owner"
BR2_BACKUP_SITE="https://dl.nerves-project.org"
BR2_GLOBAL_PATCH_DIR="${BR2_EXTERNAL_NERVES_PATH}/patches ${NERVES_DEFCONFIG_DIR}/patches"
BR2_PACKAGE_OVERRIDE_FILE="${NERVES_DEFCONFIG_DIR}/local.mk"
BR2_REPRODUCIBLE=y
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/skeleton"
BR2_INIT_NONE=y
# eudev, not plain devtmpfs: nothing runs udevd (erlinit and the OTP release
# do the work), but multipath-tools, where kpartx comes from, links libudev.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_DEVICE_TABLE="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/device_table.txt"
BR2_ENABLE_LOCALE_WHITELIST="locale-archive"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-build.sh ${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-createfs.sh"

# Kernel: mlainez/linux-mt8127, branch 6.18/staging (v6.18.55 + the MT8127
# and TB3-710F work) at a pinned commit. The fork is not published yet:
# local.mk (see local.mk.example) points LINUX_OVERRIDE_SRCDIR at a checkout
# of this commit until it is.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/mlainez/linux-mt8127/archive/8591585617ca0ffdf770b9ab53d4264c491494aa.tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="${NERVES_DEFCONFIG_DIR}/linux-6.18.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/linux-nerves.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="mediatek/mt8127-lenovo-tb3-710f"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# Not BR2_LINUX_KERNEL_INSTALL_TARGET: the kernel, the DTB and the initramfs
# live in the FAT boot slots next to extlinux.conf
# (scripts/create-boot-files.sh, fwup.conf); a copy in the squashfs would
# never run.

# Second stage: mainline U-Boot v2026.10 with the MT8127/TB3-710F series in
# patches/uboot (see patches/uboot/README.md). LK loads u-boot.bin (DTB
# appended) from the `boot` partition as if it were a kernel
# (scripts/create-boot-files.sh packs images/boot.img); U-Boot then boots
# /extlinux/extlinux.conf from the active boot slot.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://source.denx.de/u-boot/u-boot.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="v2026.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="mt8127_tb3_710f"
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y

# Busybox / base userland
BR2_PACKAGE_BUSYBOX_CONFIG="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/busybox.config"
# The applets the citronics initramfs needs on top of the Nerves base config.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/busybox-tb3.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# nerves_runtime formats /root with mkfs.f2fs when it does not mount.
BR2_PACKAGE_F2FS_TOOLS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_CA_CERTIFICATES=y
# nerves_uevent (nerves_runtime) talks netlink through libmnl.
BR2_PACKAGE_LIBMNL=y
# kpartx maps the Nerves partitions nested in userdata, in the initramfs.
BR2_PACKAGE_MULTIPATH_TOOLS=y

# GPU: Mali-450 through lima, KMS through mediatek-drm.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LIMA=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# Audio: MT6323 codec through the MT8127 AFE. The application sets the mixer.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y

# Wi-Fi: CONSYS through the out-of-tree WMT stack (mt8127-*), nl80211.
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_EAP=y
BR2_PACKAGE_WPA_SUPPLICANT_WPS=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA_CLIENT_SO=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y

# Bluetooth: CONSYS BT (mtk_consys_bt), BlueZ userspace.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y

# Cameras: the kernel side (mt8127-camera) and V4L2 tools. libcamera is not
# included: the MT8127 pipeline patches target libcamera 0.5 and do not apply
# to the 0.7 this Buildroot ships.
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y

# Diagnostics usable from the IEx shell.
BR2_PACKAGE_IW=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_USBUTILS=y

# Nerves bookkeeping
BR2_NERVES_SYSTEM_NAME="nerves_system_lenovo_tb3_710f"
BR2_NERVES_ADDITIONAL_IMAGE_FILES="${NERVES_DEFCONFIG_DIR}/fwup.conf"
BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y

# Root filesystem: squashfs, A/B, nested inside the stock userdata partition
# with the boot slots and the application data (fwup_include/fwup-common.conf).
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
# BR2_TARGET_ROOTFS_TAR is not set

# This system's own packages, see packages/README.md.
BR2_PACKAGE_CITRONICS_INITRAMFS=y
BR2_PACKAGE_UNUDHCPD=y
BR2_PACKAGE_TB3_FIRMWARE=y
BR2_PACKAGE_TB3_TOOLS=y
BR2_PACKAGE_MT8127_BTIF=y
BR2_PACKAGE_MT8127_CONSYS=y
BR2_PACKAGE_MT8127_WMT=y
BR2_PACKAGE_MT8127_WLAN=y
BR2_PACKAGE_MT8127_BT=y
BR2_PACKAGE_MT8127_FM=y
BR2_PACKAGE_MT8127_CAMERA=y
