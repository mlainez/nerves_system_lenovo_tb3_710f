# boardid.config
#
# erlinit runs this (-d /usr/bin/boardid) to build the hostname. That matters
# for more than cosmetics: VintageNetDirect picks the usb0 /30 by hashing the
# hostname, so two tablets answering to the same name claim the same address.

# A serial number provisioned with fwup (NERVES_SERIAL_NUMBER at
# `mix firmware.image` / `mix burn` time), as in the official systems.
-b uboot_env -u nerves_serial_number
-b uboot_env -u serial_number

# The eMMC CID. Offset 20 skips the manufacturer and product-name fields,
# identical across units, and lands on the card's serial number. `-t text`
# keeps the hex digits as sysfs prints them.
-b binfile -f /sys/block/mmcblk0/device/cid -k 20 -l 8 -t text

# Last resort, so a device without it still gets an ID.
-b cpuinfo
