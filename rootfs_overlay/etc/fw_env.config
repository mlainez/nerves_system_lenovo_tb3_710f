# fw_printenv and fw_setenv configuration
#
# A key/value store for the Nerves firmware metadata in U-Boot environment
# format, read and written by Nerves Runtime and fwup. It lives 1 MiB into
# the stock userdata partition (UBOOT_ENV_OFFSET 2048 blocks, UBOOT_ENV_COUNT
# 16 blocks = 8 KiB, see fwup_include/fwup-common.conf).

# Device name		Device offset	Env. size	Flash sector size	Number of sectors
/dev/mmcblk0p7		0x100000	0x2000		0x200			16
