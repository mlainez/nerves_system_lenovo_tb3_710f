# Kernel config fragment for nerves_system_lenovo_tb3_710f.
#
# The base config, linux-6.18.defconfig, is the Buildroot board config
# verbatim (buildroot-android buildroot-external/board/tb3_710f/linux.config),
# so the two stay comparable; the Nerves deltas live here. They follow the
# official nerves-project systems (rpi4/rpi5, bbb) except where this tablet
# needs otherwise. dossier/nerves-config-review.md has the table.
#
# Buildroot merges this on top and runs olddefconfig: an option whose
# dependencies are unmet is dropped rather than breaking the build.

# --- Command line ---------------------------------------------------------------
#
# The command line comes from the bootloader: the second stage passes the
# APPEND line of the active slot's extlinux.conf (extlinux/extlinux.conf).
# CONFIG_CMDLINE is only the fallback when a bootloader passes none.
# regulator_ignore_unused keeps the eMMC, USB and IO rails the bootloader
# enabled; they have no consumer in the device tree.
# CONFIG_CMDLINE_FORCE is not set
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE="console=tty0 loglevel=5 regulator_ignore_unused"

# --- Built in, because they are needed before any module can load -------------
# As in the official systems: gzip (mksquashfs' default, what `mix firmware`
# writes), decompressed straight into the page cache, one decompressor per CPU.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
# CONFIG_SQUASHFS_LZ4 is not set
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
CONFIG_F2FS_FS=y
# kpartx maps the nested partitions through device-mapper.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_RD_GZIP=y

# --- USB networking ------------------------------------------------------------
#
# g_ether, built in, for the initramfs recovery shell and VintageNetDirect on
# usb0, as on the Buildroot board.
CONFIG_USB_ETH=y

# --- Modules -------------------------------------------------------------------
#
# Nerves' kmod has no decompressor; modules ship in a read-only squashfs
# written as one image, so signing would buy nothing and break
# BR2_REPRODUCIBLE.
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_SIG is not set

# MEDIA_SUPPORT=m without the filter builds every DVB frontend and tuner.
# Only cameras (mt8127-camera), the FM radio (mt8127-fm) and platform drivers
# are used.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_RADIO_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_MEDIA_USB_SUPPORT is not set

# --- Reliability, as in the official systems -----------------------------------
#
# nerves_heart opens /dev/watchdog0 (mtk_wdt, 31 s maximum) and takes over
# from the kernel's boot-time pinging; once opened it cannot be stopped, so a
# hung BEAM resets the tablet.
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_FANOTIFY=y

# erlinit mounts the cpu cgroup controller, as in the official systems.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y

# --- Networking, as in the official systems ------------------------------------
CONFIG_IPV6=y
# CONFIG_IPV6_SIT is not set
CONFIG_IP_MULTICAST=y
CONFIG_MPTCP=y
# CONFIG_INET_DIAG is not set

# --- Filesystems -----------------------------------------------------------------
#
# Kept: ext4 (stock system/cache), vfat and exfat (USB sticks over OTG), f2fs,
# squashfs, tmpfs, pstore. Dropped: overlayfs (nothing in Nerves stacks
# layers) and the network filesystems.
# CONFIG_OVERLAY_FS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set

# --- Debugging ---------------------------------------------------------------------
#
# debugfs and pstore/ramoops stay: drivers on this tablet are still being
# brought up. No boot logo (a first-light aid).
# CONFIG_LOGO is not set
# CONFIG_FTRACE is not set
# CONFIG_KALLSYMS_ALL is not set
