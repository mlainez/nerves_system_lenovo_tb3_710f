From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Mon, 12 Oct 2026 11:19:37 +0200
Subject: [PATCH 3/6] Create the Nerves rootdisk symlink for nested userdata
 firmware

The root filesystem is a device-mapper subpartition inside the Android
userdata partition. erlinit cannot infer the parent firmware device from
that node, so it does not create /dev/rootdisk0 itself. Create the standard
Nerves symlink while the initramfs still has the base device path.
---
 initramfs/usr/share/citronics-initramfs/functions.sh | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/initramfs/usr/share/citronics-initramfs/functions.sh b/initramfs/usr/share/citronics-initramfs/functions.sh
index b01b959..ad9c848 100755
--- a/initramfs/usr/share/citronics-initramfs/functions.sh
+++ b/initramfs/usr/share/citronics-initramfs/functions.sh
@@ -373,6 +373,11 @@ map_and_resize_root_partition() {
     else
         echo_kmsg "No subpartition mapping required for $rootfs"
     fi
+
+    # The rootfs is a device-mapper node, so erlinit cannot infer its parent
+    # firmware device. Publish the conventional Nerves path before switch_root.
+    ln -sf "$base_device" /dev/rootdisk0
+    echo_kmsg "Created /dev/rootdisk0 -> $base_device"
 }
 
 mount_rootfs() {
