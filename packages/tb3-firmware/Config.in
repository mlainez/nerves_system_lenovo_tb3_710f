config BR2_PACKAGE_TB3_FIRMWARE
	bool "tb3-firmware [TB3-710F]"
	help
	  Proprietary firmware of the Lenovo TB3-710F: the Silead touch
	  controller image, the CONSYS Wi-Fi/Bluetooth files (WMT patches,
	  Wi-Fi RAM code, WMT_SOC.cfg) and the FM patch. The files are not
	  redistributable and are taken from a local directory prepared
	  with buildroot-android's board/tb3_710f/scripts/prepare_firmware.sh.

if BR2_PACKAGE_TB3_FIRMWARE

config BR2_PACKAGE_TB3_FIRMWARE_DIR
	string "firmware directory"
	default "$(NERVES_DEFCONFIG_DIR)/firmware"
	help
	  Directory laid out like /lib/firmware that is copied into the
	  target. The default, firmware/ in this system, is git-ignored;
	  it may be a symlink to buildroot-android's
	  board/tb3_710f/firmware.

endif
